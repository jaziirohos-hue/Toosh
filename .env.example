# Toosh configuration. Copy to .env and fill in. Never commit .env.

# --- Backend (server/) ---
# Postgres connection for the running API: a role that is NOT superuser, NOT BYPASSRLS and owns no tables
# (toosh_app). Row-level security then enforces account isolation; the server refuses other roles in production.
DATABASE_URL=postgres://toosh_app:CHANGE_ME@127.0.0.1:5432/toosh
# Migrations run as the table owner (toosh_owner) from a separate file, .env.migration (git-ignored):
#   MIGRATION_DATABASE_URL=postgres://toosh_owner:CHANGE_ME@127.0.0.1:5432/toosh
#   APP_DB_ROLE=toosh_app        # gets row access only (SELECT/INSERT/UPDATE) after each migration
# With separate roles, keep automatic migration off and run `npm run db:migrate`.
MIGRATE_ON_START=false
PORT=8787
NODE_ENV=development
# Origins allowed to call the API with a bearer token. The Android app's WebView origin is https://localhost.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173
# Secure cookies for browser sessions. Must be true behind HTTPS in production.
COOKIE_SECURE=false
# Serve the built web app (app/dist) from the API for browser viewing devices.
WEB_DIST=../app/dist
# Set when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=false
# Sign-in/registration attempts per IP per minute.
AUTH_RATE_LIMIT=10
# Requests per minute per address for all other API calls (raise only for local test runs).
RATE_LIMIT=600
LOG_LEVEL=info
# Local experiments only: allow a superuser/BYPASSRLS database role.
ALLOW_RLS_BYPASS=false

# --- App (app/) build time ---
# API base URL baked into the Android app (`npm run android -w app`). The browser build ignores it.
#   Android emulator on the same computer:  http://10.0.2.2:8787
#   Phone over USB with `adb reverse tcp:8787 tcp:8787`:  http://localhost:8787
#   Phone on the same Wi-Fi:  http://<this computer's LAN IP>:8787
#   Production:  https://your-domain
VITE_API_BASE=http://10.0.2.2:8787

# --- Server tests (npm test) ---
# A role with CREATEDB + CREATEROLE (not superuser) that creates and drops throwaway test databases.
TEST_ADMIN_DATABASE_URL=postgres://toosh_test_admin:CHANGE_ME@127.0.0.1:5432/postgres
TEST_APP_ROLE=toosh_test
TEST_APP_PASSWORD=CHANGE_ME
