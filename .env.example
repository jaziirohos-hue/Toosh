# Toosh configuration. Copy to .env and fill in. Never commit .env.

# --- Backend (server/) ---
# Postgres connection for the API. Use a normal role: NOT superuser and NOT BYPASSRLS, so row-level security
# enforces account isolation (the server refuses to start in production otherwise).
DATABASE_URL=postgres://toosh:CHANGE_ME@localhost:5432/toosh
# Optional: a different (owner) connection for migrations. Defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=
# Run migrations automatically on start (default true).
MIGRATE_ON_START=true
PORT=8787
NODE_ENV=development
# Origins allowed to call the API with a bearer token. The Android app's WebView origin is https://localhost.
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost:5173
# Secure cookies for browser sessions. Must be true behind HTTPS in production.
COOKIE_SECURE=false
# Serve the built web app (app/dist) from the API for browser viewing devices.
WEB_DIST=../app/dist
# Set when running behind a reverse proxy / load balancer that terminates TLS.
TRUST_PROXY=false
# Sign-in/registration attempts per IP per minute.
AUTH_RATE_LIMIT=10
LOG_LEVEL=info
# Local experiments only: allow a superuser/BYPASSRLS database role.
ALLOW_RLS_BYPASS=false

# --- App (app/) build time ---
# API base URL baked into the Android app. Leave empty for the browser build served by the API itself.
VITE_API_BASE=https://toosh.example.com
